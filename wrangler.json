{
	"$schema": "node_modules/wrangler/config-schema.json",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"name": "pupu",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".output/server/index.mjs",
	"assets": {
		"directory": ".output/public"
	},
	"routes": [
		{
			"pattern": "pupu.zhangxichang.com",
			"custom_domain": true
		}
	]
}
