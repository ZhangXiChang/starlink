datasource db {
  provider = "sqlite"
}

generator kysely {
  provider          = "prisma-kysely"
  output            = "src/generated"
  fileName          = "db_schema.ts"
  bytesTypeOverride = "Uint8Array"
}

model user {
  id     String @id
  key    Bytes
  name   String @unique
  avatar Bytes?
  bio    String @default("还没有自我介绍")
}

model friend {
  id       String @id
  owner_id String
  name     String
  avatar   Bytes?
  bio      String
}

model chat_message {
  timestamp    DateTime @id @default(now())
  owner_id     String
  chat_user_id String
  content      String
}
