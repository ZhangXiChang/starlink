{
  "private": true,
  "type": "module",
  "scripts": {
    "playwright:install": "playwright install --with-deps",
    "wasm:build": "wasm-pack build wasm/endpoint --target web --release",
    "generate:db-schema": "prisma generate && prisma db push && uv run scripts/db_into_schema.py temp.db",
    "generate:icon": "tauri icon public/icon.svg",
    "generate:ipc-bindings": "cargo run --bin generate_ipc_bindings",
    "install:pre": "bun run wasm:build",
    "install:post": "run-p 'generate:*' playwright:install",
    "check": "run-s 'check:*'",
    "dev": "vinxi dev",
    "build": "bun run check && vinxi build",
    "preview": "wrangler dev",
    "test": "playwright test",
    "check:tsc": "tsc",
    "check:eslint": "eslint src",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "android:init": "rimraf native/gen/android && tauri android init && uv run scripts/insert_android_sign_config.py keystore.properties",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --split-per-abi --target aarch64"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.0",
    "daisyui": "^5.5.18",
    "eslint": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.4.0",
    "prisma-kysely": "^3.0.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "^8.55.0",
    "wrangler": "^4.65.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "@pupu/endpoint": "file:wasm/endpoint/pkg",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "^1.2.1",
    "@tanstack/solid-form": "^1.28.2",
    "@tanstack/solid-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "animejs": "^4.3.6",
    "arktype": "^2.1.29",
    "comlink": "^4.4.2",
    "kysely": "^0.28.11",
    "lucide-solid": "^0.564.0",
    "octokit": "^5.0.5",
    "opfs-worker": "^1.3.1",
    "radash": "^12.1.1",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.4.0",
    "taurpc": "^1.8.1",
    "theme-change": "^2.5.0",
    "vinxi": "^0.5.11",
    "wa-sqlite": "github:rhashimoto/wa-sqlite#v1.0.9"
  }
}
